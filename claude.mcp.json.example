{
  "mcpServers": {
    "financial": {
      "command": "python",
      "args": ["-m", "mcp.financial.server"],
      "cwd": "/ABSOLUTE/PATH/TO/financial-pdf-agent-v2",
      "env": {
        "FINANCIAL_DB_PATH": "data/financials.db"
      }
    },
    "evidence": {
      "command": "python",
      "args": ["-m", "mcp.evidence.server"],
      "cwd": "/ABSOLUTE/PATH/TO/financial-pdf-agent-v2",
      "env": {
        "FINANCIAL_DB_PATH": "data/financials.db"
      }
    },
    "retrieval": {
      "command": "python",
      "args": ["-m", "mcp.retrieval.server"],
      "cwd": "/ABSOLUTE/PATH/TO/financial-pdf-agent-v2",
      "env": {
        "FINANCIAL_DB_PATH": "data/financials.db",
        "MCP_RETRIEVAL_CACHE": "data/retrieval_cache"
      }
    }
  }
}
